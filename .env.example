# Copy to .env and fill in. Never commit .env.

APP_ENV=local
LOG_LEVEL=INFO

# MongoDB (existing cluster). The platform writes only to MONGODB_DATABASE.
MONGODB_URI='mongodb+srv://<username>:<password>@<cluster>/?retryWrites=true&w=majority'
MONGODB_DATABASE=marketing_automation
# Verified CompetitorScope source database on the same MongoDB cluster.
COMPETITORSCOPE_DATABASE=competitors_monitoring_test
# Verified DCT source database on the same MongoDB cluster.
DCT_DATABASE=influencer_discovery
# Verified Pace source database on the same MongoDB cluster.
PACE_DATABASE=pace_database

# OpenAI (Agents SDK). Model names are configuration, never hard-coded.
OPENAI_API_KEY=
OPENAI_MODEL_AGENT=
OPENAI_MODEL_ROUTER=
OPENAI_MODEL_JUDGE=

# Marketing Intelligence MCP (roadmap Step 2)
MCP_URL=http://localhost:8001/mcp
MCP_ALLOWED_HOSTS='["localhost:*", "127.0.0.1:*", "[::1]:*", "mcp:8001"]'

DEFAULT_COMPANY_ID=cmp_marketing_eye
CORS_ORIGINS='["http://localhost:5173"]'

# Frontend (Vite). Leave empty locally to use the dev proxy.
VITE_API_BASE_URL=
