{
  "mcpServers": {
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp"
    },
    "mongodb": {
      "type": "stdio",
      "command": "/bin/zsh",
      "args": [
        "-lc",
        "set -a; source \"/Users/sontung/Project/Marketing-Automation/.env\"; set +a; export MDB_MCP_CONNECTION_STRING=\"$MONGODB_URI\"; exec npx -y mongodb-mcp-server@3.0.4 --readOnly"
      ],
      "env": {}
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PAT}"
      }
    }
  }
}
